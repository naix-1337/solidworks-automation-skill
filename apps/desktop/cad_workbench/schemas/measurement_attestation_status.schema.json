{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cad-studio.local/schemas/measurement_attestation_status.schema.json",
  "title": "CAD Measurement Attestation Online Status",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "attestationId",
    "status",
    "verifierPolicy",
    "checkedAt",
    "expiresAt",
    "signer",
    "signature"
  ],
  "properties": {
    "schema": {
      "const": "cad-attestation-status/v1"
    },
    "attestationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "status": {
      "enum": ["active", "revoked", "blocked"]
    },
    "verifierPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflowRepository",
        "workflowRef",
        "workflowSha",
        "toolkitSha256",
        "pythonVersion",
        "platform",
        "dependencyLockSha256",
        "dependencyVersionsSha256"
      ],
      "properties": {
        "workflowRepository": {
          "type": "string",
          "minLength": 1
        },
        "workflowRef": {
          "type": "string",
          "minLength": 1
        },
        "workflowSha": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{40}$"
        },
        "toolkitSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "pythonVersion": {
          "type": "string",
          "minLength": 1
        },
        "platform": {
          "type": "string",
          "minLength": 1
        },
        "dependencyLockSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "dependencyVersionsSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "checkedAt": {
      "type": "string",
      "minLength": 1
    },
    "expiresAt": {
      "type": "string",
      "minLength": 1
    },
    "signer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "keyId", "signedAt"],
      "properties": {
        "algorithm": {
          "const": "Ed25519"
        },
        "keyId": {
          "type": "string",
          "pattern": "^ed25519:[0-9a-f]{64}$"
        },
        "signedAt": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "signature": {
      "type": "string",
      "minLength": 1
    }
  }
}
